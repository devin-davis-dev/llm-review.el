;;; Commentary:

;; `llm-review' is a production-ready Emacs package providing a Magit-style
;; code review interface for findings generated by Large Language Model (LLM)
;; coding assistants and external static analysis tools.
;;
;; Key features:
;; - Uses `magit-section' as the UI engine for collapsible code snippet previews.
;; - Converts LLM findings (file paths, start_line, end_line) into live Emacs
;;   buffer markers (`make-marker' with insertion type `t').  This prevents
;;   line-number drift as edits or deletions occur elsewhere in the source buffers.
;; - Defines `llm-review-mode' derived from `magit-section-mode' with intuitive
;;   single-key bindings:
;;     - TAB: Toggle code snippet preview (`magit-section-toggle')
;;     - d: Delete the target code block in the source buffer, clean up markers,
;;          and refresh the UI.
;;     - x: Dismiss the finding without modifying the source file.
;;     - RET: Jump to the exact source location (`llm-review-visit').
;;     - n / p: Navigate to next/previous finding.
;;     - g: Refresh the review buffer with dynamically updated line numbers.
;; - Ingests JSON arrays of findings generated by external CLI tools via
;;   `llm-review-load-file'.

;;; Code:

(require 'cl-lib)
(require 'json)
(require 'magit-section)
(require 'pulse nil t)

;;; Customization

(defgroup llm-review nil
  "Magit-style code review UI for LLM findings."
  :prefix "llm-review-"
  :group 'tools
  :group 'convenience)

(defcustom llm-review-buffer-name "*llm-review*"
  "Name of the review buffer."
  :type 'string
  :group 'llm-review)

(defcustom llm-review-confirm-delete nil
  "Whether to prompt for confirmation before deleting a code block."
  :type 'boolean
  :group 'llm-review)

(defcustom llm-review-highlight-source-on-visit t
  "Whether to pulse/highlight the source region when visited via `RET'."
  :type 'boolean
  :group 'llm-review)

(defcustom llm-review-collapse-snippets-by-default nil
  "Whether code snippet previews should be collapsed by default."
  :type 'boolean
  :group 'llm-review)

(defcustom llm-review-show-line-numbers t
  "Whether to show line numbers in code preview snippets."
  :type 'boolean
  :group 'llm-review)

(defcustom llm-review-max-preview-lines 300
  "Maximum number of lines to display in a single snippet preview.
Prevents performance degradation on unusually large blocks."
  :type 'integer
  :group 'llm-review)

;;; Faces

(defgroup llm-review-faces nil
  "Faces used by `llm-review'."
  :group 'llm-review
  :group 'faces)

(defface llm-review-action
  '((t :weight bold))
  "Base face for finding actions."
  :group 'llm-review-faces)

(defface llm-review-action-delete
  '((((class color) (background light)) :foreground "#d70000" :inherit llm-review-action)
    (((class color) (background dark))  :foreground "#ff6b6b" :inherit llm-review-action)
    (t :inherit (error llm-review-action)))
  "Face for `delete' actions."
  :group 'llm-review-faces)

(defface llm-review-action-refactor
  '((((class color) (background light)) :foreground "#0066cc" :inherit llm-review-action)
    (((class color) (background dark))  :foreground "#63b2ff" :inherit llm-review-action)
    (t :inherit (font-lock-function-name-face llm-review-action)))
  "Face for `refactor' actions."
  :group 'llm-review-faces)

(defface llm-review-action-fix
  '((((class color) (background light)) :foreground "#d97706" :inherit llm-review-action)
    (((class color) (background dark))  :foreground "#fbbf24" :inherit llm-review-action)
    (t :inherit (warning llm-review-action)))
  "Face for `fix' actions."
  :group 'llm-review-faces)

(defface llm-review-action-default
  '((t :inherit (font-lock-keyword-face llm-review-action)))
  "Face for unrecognized or default actions."
  :group 'llm-review-faces)

(defface llm-review-title
  '((t :inherit bold))
  "Face for finding titles in section headings."
  :group 'llm-review-faces)

(defface llm-review-location
  '((t :inherit shadow))
  "Face for file and line number locations."
  :group 'llm-review-faces)

(defface llm-review-label
  '((t :inherit font-lock-comment-face :weight bold))
  "Face for metadata field labels like `Reason:' or `Action:'."
  :group 'llm-review-faces)

(defface llm-review-reason
  '((t :inherit default))
  "Face for finding reason descriptions."
  :group 'llm-review-faces)

(defface llm-review-line-number
  '((t :inherit shadow))
  "Face for line number prefixes in code previews."
  :group 'llm-review-faces)

(defface llm-review-snippet-heading
  '((t :inherit magit-section-heading))
  "Face for code snippet subsection headings."
  :group 'llm-review-faces)

(defface llm-review-header
  '((t :inherit magit-section-heading :weight bold))
  "Face for review buffer header."
  :group 'llm-review-faces)

;;; Section Classes

(defclass llm-review-finding-section (magit-section) ()
  "Section representing an individual LLM finding.")

(defclass llm-review-snippet-section (magit-section) ()
  "Section representing a collapsible code snippet preview.")

;;; Buffer-local Variables

(defvar-local llm-review--findings nil
  "List of loaded finding alists in the current review buffer.")

(defvar-local llm-review--repo-root nil
  "Repository root directory associated with the current review buffer.")

(defvar-local llm-review--source-file nil
  "Source JSON file path from which findings were ingested.")

;;; Utilities & Field Accessors

(defun llm-review--field (finding &rest keys)
  "Retrieve value for any of KEYS from FINDING.
FINDING can be an alist or plist.  KEYS are candidate symbols or strings."
  (let (result)
    (while (and keys (null result))
      (let* ((key (car keys))
             (str (if (symbolp key) (symbol-name key) key))
             (sym (intern str))
             (kwd (intern (concat ":" str))))
        (setq keys (cdr keys))
        (setq result
              (cond
               ((null finding) nil)
               ((and (consp finding) (consp (car finding)))
                (or (cdr (assq sym finding))
                    (cdr (assoc str finding))))
               ((listp finding)
                (or (plist-get finding kwd)
                    (plist-get finding sym)))))))
    result))

(defun llm-review--as-number (val)
  "Convert VAL to integer if possible, or return nil."
  (cond
   ((numberp val) (truncate val))
   ((stringp val) (string-to-number val))
   (t nil)))

(defun llm-review--action-face (action)
  "Return face symbol corresponding to ACTION string."
  (let ((act (downcase (or action ""))))
    (cond
     ((string-equal act "delete") 'llm-review-action-delete)
     ((string-equal act "refactor") 'llm-review-action-refactor)
     ((string-equal act "fix") 'llm-review-action-fix)
     (t 'llm-review-action-default))))

;;; JSON Parsing

(defun llm-review--parse-json-file (file)
  "Parse JSON array from FILE into a Lisp list of alists."
  (unless (file-readable-p file)
    (error "Review file %s is not readable or does not exist" file))
  (with-temp-buffer
    (insert-file-contents file)
    (goto-char (point-min))
    (let ((json-object-type 'alist)
          (json-array-type 'list)
          (json-key-type 'symbol))
      (if (fboundp 'json-parse-buffer)
          (json-parse-buffer :object-type 'alist :array-type 'list)
        (json-read)))))

;;; Marker Management

(defun llm-review--create-finding-markers (finding repo-root)
  "Create live buffer markers for FINDING relative to REPO-ROOT.
Converts `start_line' and `end_line' using `make-marker' with
insertion type `t', preventing line-number drift as edits or
deletions occur in the source buffer.  Returns updated finding alist."
  (let* ((rel-file (llm-review--field finding 'file))
         (full-path (expand-file-name (or rel-file "") (or repo-root default-directory)))
         (start-ln (or (llm-review--as-number (llm-review--field finding 'start_line 'start-line)) 1))
         (end-ln (or (llm-review--as-number (llm-review--field finding 'end_line 'end-line)) start-ln))
         (updated (copy-alist finding)))
    (if (not (file-exists-p full-path))
        (progn
          (message "llm-review: Warning: Target file %s does not exist" full-path)
          (setf (alist-get 'full-file updated) full-path)
          (setf (alist-get 'rel-file updated) rel-file)
          (setf (alist-get 'start-marker updated) nil)
          (setf (alist-get 'end-marker updated) nil)
          (setf (alist-get 'buffer updated) nil)
          updated)
      (let ((buf (find-file-noselect full-path)))
        (with-current-buffer buf
          (save-restriction
            (widen)
            (save-excursion
              (let ((s-marker (make-marker))
                    (e-marker (make-marker)))
                ;; Explicit requirement: insertion-type t advances marker on insertion
                (set-marker-insertion-type s-marker t)
                (set-marker-insertion-type e-marker t)

                ;; Position start-marker at line-beginning-position of start_line
                (goto-char (point-min))
                (forward-line (1- (max 1 start-ln)))
                (set-marker s-marker (point) buf)

                ;; Position end-marker at line-end-position of end_line
                (goto-char (point-min))
                (forward-line (1- (max 1 end-ln)))
                (let ((end-pos (line-end-position)))
                  (when (< end-pos (marker-position s-marker))
                    (setq end-pos (marker-position s-marker)))
                  (set-marker e-marker end-pos buf))

                (setf (alist-get 'full-file updated) full-path)
                (setf (alist-get 'rel-file updated) rel-file)
                (setf (alist-get 'start-marker updated) s-marker)
                (setf (alist-get 'end-marker updated) e-marker)
                (setf (alist-get 'buffer updated) buf)
                updated))))))))

(defun llm-review--cleanup-markers (finding)
  "Free buffer markers associated with FINDING."
  (let ((s (alist-get 'start-marker finding))
        (e (alist-get 'end-marker finding)))
    (when (markerp s) (set-marker s nil))
    (when (markerp e) (set-marker e nil))))

(defun llm-review--cleanup-all-markers ()
  "Free all buffer markers associated with findings in review buffer."
  (dolist (finding llm-review--findings)
    (llm-review--cleanup-markers finding))
  (setq llm-review--findings nil))

(defun llm-review--finding-current-lines (finding)
  "Return (START-LINE . END-LINE) computed from live markers in FINDING."
  (let ((s (alist-get 'start-marker finding))
        (e (alist-get 'end-marker finding)))
    (if (and (markerp s) (marker-position s) (marker-buffer s) (buffer-live-p (marker-buffer s)))
        (with-current-buffer (marker-buffer s)
          (save-restriction
            (widen)
            (cons (line-number-at-pos (marker-position s))
                  (if (and (markerp e) (marker-position e))
                      (line-number-at-pos (marker-position e))
                    (line-number-at-pos (marker-position s))))))
      (cons (or (llm-review--as-number (llm-review--field finding 'start_line 'start-line)) 1)
            (or (llm-review--as-number (llm-review--field finding 'end_line 'end-line)) 1)))))

;;; Code Snippet Formatting

(defun llm-review--format-snippet (finding)
  "Format code snippet for FINDING with line numbers and syntax highlighting."
  (let* ((s-marker (alist-get 'start-marker finding))
         (e-marker (alist-get 'end-marker finding))
         (buf (and (markerp s-marker) (marker-buffer s-marker))))
    (cond
     ((not (and buf (buffer-live-p buf)))
      "      [Source buffer not available]\n")
     ((not (and (marker-position s-marker) (marker-position e-marker)))
      "      [Invalid marker position]\n")
     (t
      (with-current-buffer buf
        (save-restriction
          (widen)
          (let* ((beg (marker-position s-marker))
                 (end (marker-position e-marker)))
            (if (> beg end)
                "      [Empty or reversed code range]\n"
              ;; Ensure syntax highlighting is active
              (font-lock-ensure beg end)
              (let* ((start-line (line-number-at-pos beg))
                     (src-buf buf))
                (with-temp-buffer
                  (insert-buffer-substring src-buf beg end)
                  (goto-char (point-min))
                  (let ((cur-line start-line)
                        (lines-count 0)
                        (out-str ""))
                    (while (and (not (eobp))
                                (< lines-count llm-review-max-preview-lines))
                      (let* ((line (buffer-substring (point) (line-end-position)))
                             (prefix (if llm-review-show-line-numbers
                                         (propertize (format "      %4d | " cur-line)
                                                     'face 'llm-review-line-number)
                                       "      | ")))
                        (setq out-str (concat out-str prefix line "\n"))
                        (setq cur-line (1+ cur-line))
                        (setq lines-count (1+ lines-count))
                        (forward-line 1)))
                    (when (not (eobp))
                      (setq out-str (concat out-str
                                            (propertize "      [... remaining lines truncated ...]\n"
                                                        'face 'llm-review-line-number))))
                    out-str)))))))))))

;;; Navigation & Selection Helpers

(defun llm-review-current-finding (&optional section)
  "Return finding alist for SECTION (defaulting to section at point)."
  (let ((sec (or section (magit-current-section))))
    (while (and sec
                (not (eq (oref sec type) 'llm-review-finding-section))
                (not (and (fboundp 'magit-section-match)
                          (magit-section-match 'llm-review-finding-section sec))))
      (setq sec (oref sec parent)))
    (and sec (oref sec value))))

(defun llm-review-next-finding ()
  "Move point forward to the next finding heading."
  (interactive)
  (let ((sec (magit-current-section)))
    (while (and sec (not (eq (oref sec type) 'llm-review-finding-section)))
      (setq sec (oref sec parent)))
    (if sec
        (let* ((siblings (oref (oref sec parent) children))
               (pos (cl-position sec siblings))
               (next (and pos (< (1+ pos) (length siblings)) (nth (1+ pos) siblings))))
          (if next
              (goto-char (oref next start))
            (message "No next finding")))
      (magit-section-forward))))

(defun llm-review-previous-finding ()
  "Move point backward to the previous finding heading."
  (interactive)
  (let ((sec (magit-current-section)))
    (while (and sec (not (eq (oref sec type) 'llm-review-finding-section)))
      (setq sec (oref sec parent)))
    (if sec
        (let* ((siblings (oref (oref sec parent) children))
               (pos (cl-position sec siblings))
               (prev (and pos (> pos 0) (nth (1- pos) siblings))))
          (if prev
              (goto-char (oref prev start))
            (message "No previous finding")))
      (magit-section-backward))))

;;; UI Rendering

(defun llm-review--render-buffer (&optional target-finding)
  "Render findings in the review buffer.
If TARGET-FINDING is provided, move point to its section after rendering."
  (let ((inhibit-read-only t)
        (findings llm-review--findings)
        (repo-root llm-review--repo-root)
        (source-file llm-review--source-file))
    (erase-buffer)
    ;; Root section wrapper enables collapsible subsections in magit-section
    (magit-insert-section (magit-section)
      ;; Buffer header
      (insert (propertize "LLM Code Review\n" 'face 'llm-review-header))
      (insert (propertize (format "Source:   %s\n" (or source-file "in-memory"))
                          'face 'llm-review-location))
      (insert (propertize (format "Root:     %s\n" (or repo-root default-directory))
                          'face 'llm-review-location))
      (insert (propertize (format "Findings: %d remaining\n" (length findings))
                          'face 'llm-review-location))
      (insert (propertize "Keys:     [TAB] toggle preview | [RET] visit | [d] delete | [x] dismiss | [n/p] nav | [g] refresh | [q] quit\n\n"
                          'face 'font-lock-comment-face))

      (if (null findings)
          (insert (propertize "  ✓ All findings resolved! (0 remaining)\n\n"
                              'face 'success))
        ;; Insert each finding as a collapsible section
        (dolist (finding findings)
          (let* ((title (or (llm-review--field finding 'title) "Untitled Finding"))
                 (action (or (llm-review--field finding 'action) "review"))
                 (reason (llm-review--field finding 'reason))
                 (rel-file (or (alist-get 'rel-file finding)
                               (llm-review--field finding 'file)
                               "unknown"))
                 (line-pair (llm-review--finding-current-lines finding))
                 (start-ln (car line-pair))
                 (end-ln (cdr line-pair))
                 (action-str (format "[%s]" (downcase action)))
                 (act-face (llm-review--action-face action)))
            (magit-insert-section (llm-review-finding-section finding nil)
              ;; Heading: [action] Title (file:start-end)
              (magit-insert-heading
                (propertize (format "%-10s " action-str) 'face act-face)
                (propertize (format "%s " title) 'face 'llm-review-title)
                (propertize (format "(%s:%d-%d)" rel-file start-ln end-ln)
                            'face 'llm-review-location))
              ;; Metadata body
              (when reason
                (insert "    " (propertize "Reason: " 'face 'llm-review-label)
                        (propertize reason 'face 'llm-review-reason) "\n"))
              (insert "    " (propertize "Action: " 'face 'llm-review-label)
                      (propertize action 'face act-face) "\n")
              ;; Collapsible Code Snippet subsection
              (magit-insert-section (llm-review-snippet-section finding llm-review-collapse-snippets-by-default)
                (magit-insert-heading
                  (propertize (format "    Preview (lines %d-%d):" start-ln end-ln)
                              'face 'llm-review-snippet-heading))
                (insert (llm-review--format-snippet finding)))
              (insert "\n"))))))
    ;; Restore or move point
    (if (and target-finding (boundp 'magit-root-section) magit-root-section)
        (let ((sec (cl-find target-finding (oref magit-root-section children)
                            :key (lambda (s) (oref s value))
                            :test #'equal)))
          (if sec
              (goto-char (oref sec start))
            (goto-char (point-min))))
      (goto-char (point-min)))))

;;; Commands

(defun llm-review-refresh ()
  "Refresh the review buffer, updating line numbers dynamically from markers."
  (interactive)
  (let ((cur-finding (llm-review-current-finding)))
    (llm-review--render-buffer cur-finding)
    (message "LLM review refreshed.")))

(defun llm-review-visit ()
  "Jump to the exact source location of the finding at point (`RET')."
  (interactive)
  (let ((finding (llm-review-current-finding)))
    (unless finding
      (user-error "No LLM review finding at point"))
    (let* ((s-marker (alist-get 'start-marker finding))
           (e-marker (alist-get 'end-marker finding))
           (buf (and (markerp s-marker) (marker-buffer s-marker))))
      (unless (and buf (buffer-live-p buf))
        (let ((file (alist-get 'full-file finding)))
          (if (and file (file-exists-p file))
              (setq buf (find-file-noselect file))
            (user-error "Source file not found: %s" (or file "unknown")))))
      (pop-to-buffer buf)
      (save-restriction
        (widen)
        (let ((pos (if (and (markerp s-marker) (marker-position s-marker))
                       (marker-position s-marker)
                     (goto-char (point-min))
                     (forward-line (1- (max 1 (or (llm-review--as-number (llm-review--field finding 'start_line)) 1))))
                     (point)))
              (end-pos (if (and (markerp e-marker) (marker-position e-marker))
                           (marker-position e-marker)
                         (line-end-position))))
          (goto-char pos)
          (recenter)
          (when (and llm-review-highlight-source-on-visit (fboundp 'pulse-momentary-highlight-region))
            (pulse-momentary-highlight-region pos end-pos 'highlight)))))))

(defun llm-review-delete ()
  "Delete the target code block in the source buffer (`d').
Clean up markers and refresh the UI."
  (interactive)
  (let ((finding (llm-review-current-finding)))
    (unless finding
      (user-error "No LLM review finding at point"))
    (let* ((s-marker (alist-get 'start-marker finding))
           (e-marker (alist-get 'end-marker finding))
           (buf (and (markerp s-marker) (marker-buffer s-marker)))
           (title (or (llm-review--field finding 'title) "code block")))
      (unless (and buf (buffer-live-p buf))
        (user-error "Source buffer is no longer live"))
      (unless (and (marker-position s-marker) (marker-position e-marker))
        (user-error "Marker positions are no longer valid"))
      (let* ((beg (marker-position s-marker))
             (end (marker-position e-marker))
             (start-ln (with-current-buffer buf (line-number-at-pos beg)))
             (end-ln (with-current-buffer buf (line-number-at-pos end))))
        (when (or (not llm-review-confirm-delete)
                  (yes-or-no-p (format "Delete block in %s (lines %d-%d)? "
                                      (buffer-name buf) start-ln end-ln)))
          (with-current-buffer buf
            (save-restriction
              (widen)
              ;; Determine full deletion range, cleanly removing trailing newline
              (let* ((del-beg beg)
                     (del-end (if (and (< end (point-max))
                                       (= (char-after end) ?\n))
                                  (1+ end)
                                end)))
                ;; If at very end of buffer without trailing newline, remove preceding newline
                (when (and (= del-end (point-max))
                           (> del-beg (point-min))
                           (= (char-before del-beg) ?\n))
                  (setq del-beg (1- del-beg)))
                (delete-region del-beg del-end))))
          ;; Clean up markers
          (llm-review--cleanup-markers finding)
          ;; Compute next target finding before removal
          (let* ((idx (cl-position finding llm-review--findings))
                 (new-findings (delq finding llm-review--findings))
                 (next-target (and new-findings
                                   (nth (min idx (1- (length new-findings))) new-findings))))
            (setq llm-review--findings new-findings)
            (llm-review--render-buffer next-target)
            (message "Deleted code block: %s" title)))))))

(defun llm-review-dismiss ()
  "Dismiss the finding without modifying the source file (`x')."
  (interactive)
  (let ((finding (llm-review-current-finding)))
    (unless finding
      (user-error "No LLM review finding at point"))
    (let ((title (or (llm-review--field finding 'title) "finding")))
      (llm-review--cleanup-markers finding)
      (let* ((idx (cl-position finding llm-review--findings))
             (new-findings (delq finding llm-review--findings))
             (next-target (and new-findings
                               (nth (min idx (1- (length new-findings))) new-findings))))
        (setq llm-review--findings new-findings)
        (llm-review--render-buffer next-target)
        (message "Dismissed: %s" title)))))

(defun llm-review-clear ()
  "Clear all findings and clean up all markers."
  (interactive)
  (when (or (null llm-review--findings)
            (yes-or-no-p (format "Clear all %d findings? " (length llm-review--findings))))
    (llm-review--cleanup-all-markers)
    (llm-review--render-buffer)
    (message "All LLM review findings cleared.")))

;;; Major Mode

(defvar llm-review-mode-map
  (let ((map (make-sparse-keymap)))
    ;; Exact required keybindings
    (define-key map (kbd "TAB")   #'magit-section-toggle)
    (define-key map [tab]         #'magit-section-toggle)
    (define-key map (kbd "d")     #'llm-review-delete)
    (define-key map (kbd "x")     #'llm-review-dismiss)
    (define-key map (kbd "RET")   #'llm-review-visit)
    ;; Ergonomic navigation and utility bindings
    (define-key map (kbd "n")     #'llm-review-next-finding)
    (define-key map (kbd "p")     #'llm-review-previous-finding)
    (define-key map (kbd "g")     #'llm-review-refresh)
    (define-key map (kbd "q")     #'quit-window)
    (define-key map (kbd "C-c C-k") #'llm-review-clear)
    map)
  "Keymap for `llm-review-mode'.")

(define-derived-mode llm-review-mode magit-section-mode "LLM-Review"
  "Major mode for reviewing LLM-generated code findings.

Keybindings:
\\{llm-review-mode-map}"
  :group 'llm-review
  (setq-local buffer-read-only t)
  (setq-local truncate-lines t)
  (add-hook 'kill-buffer-hook #'llm-review--cleanup-all-markers nil t))

;;; Ingestion Entry Point

;;;###autoload
(defun llm-review-load-file (json-file &optional repo-root)
  "Ingest JSON array of findings from JSON-FILE generated by external CLI tools.
REPO-ROOT defaults to the current `default-directory' if not specified.
Converts file paths and line ranges into live Emacs buffer markers with
insertion type `t', then presents findings in `llm-review-mode'."
  (interactive "fFindings JSON file: \nDRepo root: ")
  (let* ((expanded-json (expand-file-name json-file))
         (root (file-name-as-directory (expand-file-name (or repo-root default-directory))))
         (raw-findings (llm-review--parse-json-file expanded-json)))
    (unless (listp raw-findings)
      (user-error "Expected a JSON array of findings in %s" expanded-json))

    ;; Map raw findings into findings with live buffer markers
    (let ((processed (mapcar (lambda (f)
                               (llm-review--create-finding-markers f root))
                             raw-findings))
          (buf (get-buffer-create llm-review-buffer-name)))
      (with-current-buffer buf
        ;; Clean up old markers if refreshing existing buffer
        (llm-review--cleanup-all-markers)
        (llm-review-mode)
        (setq llm-review--findings processed)
        (setq llm-review--repo-root root)
        (setq llm-review--source-file expanded-json)
        (llm-review--render-buffer))
      (pop-to-buffer buf)
      (message "Loaded %d review finding(s) from %s" (length processed) expanded-json)
      buf)))

(provide 'llm-review)

;;; llm-review.el ends here
