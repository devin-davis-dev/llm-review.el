  "Name of the review buffer."
  :type 'string
  :group 'llm-review)

(defcustom llm-review-confirm-delete nil
  "Whether to prompt for confirmation before deleting a code block."
  :type 'boolean
  :group 'llm-review)

(defcustom llm-review-highlight-source-on-visit t
  "Whether to pulse/highlight the source region when visited via `RET'."
  :type 'boolean
  :group 'llm-review)

(defcustom llm-review-collapse-snippets-by-default nil
  "Whether code snippet previews should be collapsed by default."
  :type 'boolean
  :group 'llm-review)

(defcustom llm-review-show-line-numbers t
  "Whether to show line numbers in code preview snippets."
  :type 'boolean
  :group 'llm-review)

(defcustom llm-review-max-preview-lines 300
  "Maximum number of lines to display in a single snippet preview.
Prevents performance degradation on unusually large blocks."
  :type 'integer
  :group 'llm-review)

(defcustom llm-review-highlight-deletion-snippets t
  "Whether to apply a subtle background tint to deletion preview snippets."
  :type 'boolean
  :group 'llm-review)

